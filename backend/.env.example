# Strava OAuth2 credentials (from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/v1/auth/strava/callback

# Strava webhook verification token (random string you choose)
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Application secret key (for token encryption – generate a random 32+ char string)
SECRET_KEY=

# Database URL
DATABASE_URL=postgresql://pacman:pacman_dev@localhost:5432/pacman

# Local verification harness — dedicated isolated database.
# Used ONLY by the browser verification harness; seed/reset/snapshot scripts
# refuse to run against any other database name.
VERIFICATION_DATABASE_URL=postgresql://pacman:pacman_dev@localhost:5432/pacman_verify

# Azure subscription used by infra/deploy-prod.ps1
AZURE_SUBSCRIPTION_ID=

# OSRM routing server URL
OSRM_URL=http://localhost:5000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
